# OverLord Pipeline — Variables d'environnement
# Copie ce fichier en '.env' et remplis ta clé Anthropic
# NE JAMAIS committer .env dans Git

# OBLIGATOIRE pour les agents LLM
ANTHROPIC_API_KEY=
OV_LLM_MODE=offline
OV_OLLAMA_MODEL=mistral
GROK_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# OPTIONNEL — Réseaux sociaux
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
# TWITTER_BEARER_TOKEN=
# GROK_API_KEY=xai-VOTRE_CLE

# OPTIONNEL — Instagram/Facebook
# META_ACCESS_TOKEN=
# IG_USER_ID=
# FB_PAGE_ID=



#Tous les agents basculeront automatiquement sur Ollama local. Avec OV_LLM_MODE=auto (défaut), Claude est tenté en premier, puis Ollama si échec. L'IA locale peut donc se substituer complètement à Claude pour tous les agents.
