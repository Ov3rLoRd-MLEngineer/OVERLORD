            {"shot_id":"S01_SH002","duration_seconds":3,"is_key_frame":False,"act":1,"location":"Plaine","audio_cue":"Impact sonique"},
            {"shot_id":"S01_SH003","duration_seconds":5,"is_key_frame":True,"act":1,"location":"Ciel"},
