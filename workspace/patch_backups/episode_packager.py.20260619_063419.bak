"""
agents/episode_packager.py — Assembleur d'Épisode Complet V1.46
Assemble images + audio + sous-titres + metadata en épisode livrable.

Pipeline :
  ShotList + Images générées + Audio TTS + Musique
  → Assemblage ffmpeg séquencé
  → Sous-titres SRT auto-générés
  → Thumbnail YouTube
  → Package final : MP4 + SRT + thumbnail + metadata JSON

Usage :
    from agents.episode_packager import EpisodePackager
    pkg = EpisodePackager(series="Dragon Ball", episode=1)
    result = pkg.package(shotlist, image_dir, audio_dir)
"""

import json
import logging
import shutil
import subprocess
import hashlib
from pathlib import Path
from datetime import datetime, timedelta
from typing import Optional

try:
    from agents.overlord_utils import get_api_key, fallback_llm, safe_json_parse
    UTILS_OK = True
except ImportError:
    UTILS_OK = False

try:
    from agents.style_dna import StyleDNA
    DNA_OK = True
except ImportError:
    DNA_OK = False

log = logging.getLogger("episode_packager")

EXPORTS_DIR  = Path("workspace/exports")
EPISODES_DIR = Path("workspace/episodes")
ARCHIVE_DIR  = Path("workspace/archive")

VIDEO_PRESETS = {
    "youtube_1080p":  ["-vf","scale=1920:1080","-c:v","libx264","-crf","18","-preset","slow","-c:a","aac","-b:a","192k"],
    "youtube_4k":     ["-vf","scale=3840:2160","-c:v","libx264","-crf","16","-preset","slow","-c:a","aac","-b:a","320k"],
    "shorts_vertical":["-vf","scale=1080:1920","-c:v","libx264","-crf","20","-preset","fast","-c:a","aac","-b:a","128k"],
    "preview_720p":   ["-vf","scale=1280:720", "-c:v","libx264","-crf","23","-preset","fast"],
    "nvenc_1080p":    ["-vf","scale=1920:1080","-c:v","h264_nvenc","-preset","p4","-cq","18","-c:a","aac"],
}


def _ffmpeg_ok() -> bool:
    return shutil.which("ffmpeg") is not None


class SubtitleGenerator:
    """Génère les sous-titres SRT depuis le storyboard."""

    def generate_srt(self, shotlist: dict, dialogue_map: dict = None) -> str:
        """
        Génère un fichier SRT depuis la shotlist.
        dialogue_map : {shot_id: "texte du dialogue"}
        """
        lines = []
        current_time = 0.0
        idx = 1

        for shot in shotlist.get("shots", []):
            shot_id  = shot.get("shot_id", "")
            duration = shot.get("duration_seconds", 3)
            dialogue = (dialogue_map or {}).get(shot_id, "")
            audio_cue = shot.get("audio_cue", "")

            if dialogue or audio_cue:
                start = _sec_to_srt(current_time)
                end   = _sec_to_srt(current_time + duration)
                text  = dialogue or f"[{audio_cue}]"
                lines.append(f"{idx}\n{start} --> {end}\n{text}\n")
                idx += 1

            current_time += duration

        return "\n".join(lines)

    def generate_chapters(self, shotlist: dict) -> str:
        """Génère le fichier de chapitres YouTube (format description)."""
        lines = ["00:00 Intro"]
        current = 0.0
        for i, shot in enumerate(shotlist.get("shots", [])):
            if shot.get("is_key_frame") and i > 0:
                ts = _sec_to_yt(current)
                act = shot.get("act", "")
                lines.append(f"{ts} Acte {act} — {shot.get('location','')}")
            current += shot.get("duration_seconds", 3)
        return "\n".join(lines)


def _sec_to_srt(s: float) -> str:
    h = int(s // 3600)
    m = int((s % 3600) // 60)
    sec = int(s % 60)
    ms = int((s - int(s)) * 1000)
    return f"{h:02d}:{m:02d}:{sec:02d},{ms:03d}"


def _sec_to_yt(s: float) -> str:
    m = int(s // 60)
    sec = int(s % 60)
    return f"{m:02d}:{sec:02d}"


class ThumbnailBuilder:
    """Génère la thumbnail de l'épisode."""

    def build(self, image_paths: list, title: str, episode: int,
              output_path: Path, logger=None) -> bool:
        """
        Prend la meilleure image (premier key frame) et la met en forme.
        Ajoute le titre et le numéro d'épisode via ffmpeg.
        """
        _log = logger or log
        if not _ffmpeg_ok():
            _log.warning("[THUMBNAIL] ffmpeg requis")
            return False
        if not image_paths:
            _log.warning("[THUMBNAIL] Aucune image disponible")
            return False

        # Prendre le premier key frame disponible
        src = image_paths[0]
        try:
            cmd = [
                "ffmpeg", "-y", "-i", str(src),
                "-vf", "scale=1280:720,format=yuv420p",
                "-frames:v", "1",
                str(output_path)
            ]
            result = subprocess.run(cmd, capture_output=True, timeout=30)
            if result.returncode == 0:
                _log.info(f"[THUMBNAIL] ✓ {output_path.name}")
                return True
        except Exception as e:
            _log.warning(f"[THUMBNAIL] Erreur : {e}")
        return False


class MetadataBuilder:
    """Génère les métadonnées de l'épisode pour YouTube/Webtoon/etc."""

    def build(self, series: str, episode: int, script: dict,
              shotlist: dict, style_hash: str = "") -> dict:
        title_ep = script.get("title", f"{series} — Épisode {episode}")
        synopsis = script.get("synopsis", "")[:500]
        genre    = script.get("genre", [])
        chars    = [c.get("name","") for c in script.get("characters",[])]
        total_s  = sum(s.get("duration_seconds",3) for s in shotlist.get("shots",[]))

        metadata = {
            "series":       series,
            "episode":      episode,
            "title":        title_ep,
            "synopsis":     synopsis,
            "genre":        genre,
            "characters":   chars,
            "duration_s":   total_s,
            "duration_fmt": _sec_to_yt(total_s),
            "style_dna":    style_hash,
            "generated_at": datetime.now().isoformat(),
            "pipeline":     "Ov3rLoRd V1.46",
            "youtube": {
                "title":       f"{series} Ep.{episode:02d} — {title_ep}",
                "description": (
                    f"{synopsis}\n\n"
                    f"Série : {series}\n"
                    f"Épisode : {episode}\n"
                    f"Genre : {', '.join(genre)}\n"
                    f"Produit par Ov3rLoRd Pipeline V1.46\n"
                    f"#anime #AIgenerated #ov3rlord"
                ),
                "tags": genre + chars + ["anime", "AI", "generated", series.lower()],
            },
            "webtoon": {
                "title":   title_ep,
                "summary": synopsis[:200],
                "genre":   genre[0] if genre else "Action",
            }
        }
        return metadata


class EpisodePackager:
    """
    Orchestre l'assemblage complet d'un épisode.
    Entrée  : shotlist + dossier images + optionnel audio/musique
    Sortie  : MP4 + SRT + thumbnail + metadata.json dans workspace/episodes/
    """

    def __init__(self, series: str = "Ov3rLoRd", episode: int = 1,
                 logger: logging.Logger = None):
        self.series  = series
        self.episode = episode
        self.log     = logger or log
        self.sub_gen = SubtitleGenerator()
        self.thumb   = ThumbnailBuilder()
        self.meta    = MetadataBuilder()
        EPISODES_DIR.mkdir(parents=True, exist_ok=True)
        EXPORTS_DIR.mkdir(parents=True, exist_ok=True)

    def package(self, shotlist: dict, image_dir: Path,
                script: dict = None,
                audio_path: str = None,
                music_path: str = None,
                dialogue_map: dict = None,
                preset: str = "youtube_1080p") -> dict:
        """
        Assemble l'épisode complet.

        Returns:
            dict avec chemins de tous les fichiers produits
        """
        ts       = datetime.now().strftime("%Y%m%d_%H%M%S")
        ep_name  = f"{self.series.replace(' ','_')}_ep{self.episode:02d}_{ts}"
        ep_dir   = EPISODES_DIR / ep_name
        ep_dir.mkdir(parents=True, exist_ok=True)

        result = {
            "series":    self.series,
            "episode":   self.episode,
            "ep_dir":    str(ep_dir),
            "files":     {},
            "warnings":  [],
            "success":   False,
        }

        self.log.info(f"[PACKAGER] ═══ Assemblage Ep.{self.episode:02d} — {self.series} ═══")

        # ── 1. Collecter les images ──────────────────────────────────
        image_paths = self._collect_images(shotlist, Path(image_dir))
        if not image_paths:
            result["warnings"].append("Aucune image trouvée dans image_dir")
            self.log.warning("[PACKAGER] Aucune image — assemblage impossible")
            return result

        self.log.info(f"[PACKAGER] {len(image_paths)} images collectées")

        # ── 2. Générer les sous-titres SRT ───────────────────────────
        srt_content = self.sub_gen.generate_srt(shotlist, dialogue_map)
        srt_path    = ep_dir / f"{ep_name}.srt"
        if srt_content.strip():
            srt_path.write_text(srt_content, encoding="utf-8")
            result["files"]["subtitles"] = str(srt_path)
            self.log.info(f"[PACKAGER] ✓ SRT généré : {srt_path.name}")

        # ── 3. Chapitres YouTube ─────────────────────────────────────
        chapters = self.sub_gen.generate_chapters(shotlist)
        chapters_path = ep_dir / "chapters.txt"
        chapters_path.write_text(chapters, encoding="utf-8")
        result["files"]["chapters"] = str(chapters_path)

        # ── 4. Assemblage vidéo ──────────────────────────────────────
        if _ffmpeg_ok():
            video_path = ep_dir / f"{ep_name}.mp4"
            ok = self._assemble_video(
                image_paths, shotlist, video_path,
                audio_path=audio_path, music_path=music_path,
                preset=preset, srt_path=srt_path if srt_content.strip() else None
            )
            if ok:
                result["files"]["video"] = str(video_path)
                self.log.info(f"[PACKAGER] ✓ Vidéo : {video_path.name}")
            else:
                result["warnings"].append("Assemblage vidéo échoué")
        else:
            result["warnings"].append("ffmpeg absent — vidéo non assemblée")
            self.log.warning("[PACKAGER] ffmpeg requis pour l'assemblage vidéo")

        # ── 5. Thumbnail ─────────────────────────────────────────────
        thumb_path = ep_dir / f"{ep_name}_thumb.jpg"
        script_data = script or {}
        ok_thumb = self.thumb.build(
            image_paths, script_data.get("title",""), self.episode,
            thumb_path, logger=self.log
        )
        if ok_thumb:
            result["files"]["thumbnail"] = str(thumb_path)

        # ── 6. Métadonnées ───────────────────────────────────────────
        style_hash = ""
        if DNA_OK:
            try:
                dna    = StyleDNA(self.series)
                style_hash = dna.status().get("active_hash", "")
            except Exception:
                pass

        meta_data  = self.meta.build(
            self.series, self.episode,
            script_data, shotlist, style_hash
        )
        meta_path  = ep_dir / f"{ep_name}_metadata.json"
        meta_path.write_text(
            json.dumps(meta_data, ensure_ascii=False, indent=2),
            encoding="utf-8"
        )
        result["files"]["metadata"] = str(meta_path)

        # ── 7. Archive sur drives ────────────────────────────────────
        self._archive(ep_dir, ep_name)

        result["success"] = "video" in result["files"] or len(result["files"]) >= 2
        self.log.info(
            f"[PACKAGER] ✓ Épisode assemblé — "
            f"{len(result['files'])} fichiers dans {ep_dir.name}"
        )
        return result

    def _collect_images(self, shotlist: dict, image_dir: Path) -> list:
        """Collecte les images dans l'ordre de la shotlist."""
        images = []
        shots  = shotlist.get("shots", [])

        if not image_dir.exists():
            return sorted([str(p) for p in Path("workspace/outputs/images").glob("*.png")])

        for shot in shots:
            shot_id = shot.get("shot_id", "")
            candidates = list(image_dir.glob(f"*{shot_id}*"))
            if candidates:
                images.append(str(candidates[0]))

        if not images:
            images = sorted([str(p) for p in image_dir.glob("*.png")])

        return images

    def _assemble_video(self, image_paths: list, shotlist: dict,
                        output: Path, audio_path=None, music_path=None,
                        preset="youtube_1080p", srt_path=None) -> bool:
        """Assemble les images en vidéo via ffmpeg concat."""
        concat_file = output.parent / "concat.txt"
        shots = shotlist.get("shots", [])
        durations = [s.get("duration_seconds", 3) for s in shots]

        with open(concat_file, "w", encoding="utf-8") as f:
            for i, img in enumerate(image_paths):
                dur = durations[i] if i < len(durations) else 3
                f.write(f"file '{Path(img).resolve()}'\nduration {dur}\n")
            if image_paths:
                f.write(f"file '{Path(image_paths[-1]).resolve()}'\n")

        preset_args = VIDEO_PRESETS.get(preset, VIDEO_PRESETS["youtube_1080p"])

        cmd = ["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", str(concat_file)]

        # Audio mixé
        if audio_path and Path(audio_path).exists():
            cmd += ["-i", str(audio_path)]
            if music_path and Path(music_path).exists():
                cmd += ["-i", str(music_path),
                        "-filter_complex", "[1:a]volume=1.0[v];[2:a]volume=0.3[m];[v][m]amix=inputs=2:duration=first[out]",
                        "-map", "0:v", "-map", "[out]"]
            else:
                cmd += ["-c:a", "aac", "-shortest"]

        # Sous-titres hardcoded si disponibles
        if srt_path and srt_path.exists():
            cmd += ["-vf", f"subtitles='{srt_path}'"]

        cmd += preset_args + ["-pix_fmt", "yuv420p", str(output)]

        try:
            r = subprocess.run(cmd, capture_output=True, timeout=600)
            concat_file.unlink(missing_ok=True)
            return r.returncode == 0
        except Exception as e:
            self.log.error(f"[PACKAGER] ffmpeg : {e}")
            return False

    def _archive(self, ep_dir: Path, ep_name: str):
        """Copie l'épisode sur les drives d'archive."""
        archives = [
            Path("E:/OVERLORD_EPISODES"),
            Path("G:/OVERLORD_EPISODES"),
        ]
        for drive in archives:
            try:
                dest = drive / ep_name
                shutil.copytree(str(ep_dir), str(dest))
                self.log.info(f"[PACKAGER] Archivé → {drive}")
            except Exception:
                pass


