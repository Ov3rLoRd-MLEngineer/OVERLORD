"""
agents/v120_collective.py — Ov3rLoRd V1.20 — Intelligence Collective & Nouveaux Agents

1. Agent Parliament       — vote démocratique pondéré entre agents
2. Emergent Communication — protocole de communication auto-optimisé
3. Agent Specialization   — spécialisation automatique par la performance
4. Collective Intelligence— intelligence collective > somme des parties

NOUVEAUX AGENTS (expansion du champ de vision) :
5. CareerManagerAgent     — manager de carrière artistique IA
6. PressAttacheAgent      — attaché de presse / image médiatique
7. StructuralInnovatorAgent — agent d'innovation structurelle continue
8. MonetizationAgent      — stratégie de revenus et monétisation
9. LegalComplianceAgent   — conformité légale (droits, RGPD, watermarks)
10. TalentScoutAgent      — repérage et analyse des tendances de talent IA
"""

import json
import math
import time
import random
import logging
import threading
from pathlib import Path
from dataclasses import dataclass, field
from typing import Any, Callable, Optional
from enum import Enum
import requests

COLLECTIVE_DIR = Path("workspace/collective")
ANTHROPIC_URL  = "https://api.anthropic.com/v1/messages"
CLAUDE_MODEL   = "claude-sonnet-4-6"


def _llm(prompt: str, system: str = "", max_tokens: int = 400) -> str:
    try:
        body = {"model": CLAUDE_MODEL, "max_tokens": max_tokens,
                "messages": [{"role": "user", "content": prompt}]}
        if system:
            body["system"] = system
        r = requests.post(ANTHROPIC_URL,
                          headers={
                "Content-Type": "application/json",
                "x-api-key": _get_api_key(),
                "anthropic-version": "2023-06-01",
            },
                          json=body, timeout=25)
        if r.status_code == 200:
            return r.json()["content"][0]["text"].strip()
    except Exception:
        pass
    return ""


# ══════════════════════════════════════════════════════════════════════
# 1. AGENT PARLIAMENT — Vote démocratique pondéré
# ══════════════════════════════════════════════════════════════════════

@dataclass
class Vote:
    agent:      str
    option:     str
    confidence: float = 1.0
    reasoning:  str   = ""


class AgentParliament:
    """
    Parlement d'agents — démocratie pondérée par la performance historique.

    Pour les décisions importantes (choix de style, direction narrative,
    paramètres critiques), tous les agents votent.
    Le vote est pondéré par le succès historique de chaque agent :
    un agent fiable a plus de poids qu'un agent qui se trompe souvent.

    Évite la "tyrannie du majoritaire" via le vote Condorcet simplifié.
    """

    def __init__(self, logger: logging.Logger = None):
        self.log   = logger or logging.getLogger("parliament")
        self._agent_weights: dict[str, float] = {}   # historique de fiabilité
        self._vote_history:  list[dict] = []
        COLLECTIVE_DIR.mkdir(parents=True, exist_ok=True)

    def set_agent_weight(self, agent: str, weight: float):
        self._agent_weights[agent] = max(0.1, min(3.0, weight))

    def call_vote(self, question: str,
                  options: list[str],
                  participating_agents: list[str],
                  context: dict = None) -> dict:
        """
        Organise un vote entre agents.

        Pour simuler les votes des agents non-connectés en temps réel,
        utilise le LLM pour générer leurs positions argumentées.
        """
        ctx_str = json.dumps(context or {}, ensure_ascii=False)[:300]
        votes   = []

        for agent in participating_agents:
            weight = self._agent_weights.get(agent, 1.0)
            domain_role = {
                "scenario":   "tu te soucies de la cohérence narrative",
                "storyboard": "tu penses visuellement et en termes de composition",
                "production": "tu priorise la faisabilité technique",
                "critic":     "tu évalues la qualité objective",
                "marketing":  "tu penses audience et viralité",
                "learning":   "tu optimises pour l'apprentissage long terme",
            }.get(agent, "tu as une perspective généraliste")

            prompt = (
                f"Tu es l'agent '{agent}' d'OverLord Pipeline ({domain_role}).\n"
                f"Question : {question}\n"
                f"Options : {', '.join(options)}\n"
                + (f"Contexte : {ctx_str}\n" if ctx_str else "")
                + f"Vote pour l'option qui correspond le mieux à ta perspective. "
                f"Réponds en JSON : "
                f'{{ "choice": "option exacte", "confidence": 0.8, '
                f'"reasoning": "1 phrase" }}'
            )
            result = _llm(prompt, max_tokens=150)
            try:
                if result and result.startswith("```"):
                    result = "\n".join(result.split("\n")[1:-1])
                data   = json.loads(result) if result else {}
                choice = data.get("choice", options[0])
                # Valider que le choix est dans les options
                if choice not in options:
                    choice = min(options, key=lambda o: len(set(o) ^ set(choice)))
                votes.append(Vote(
                    agent      = agent,
                    option     = choice,
                    confidence = data.get("confidence", 0.7) * weight,
                    reasoning  = data.get("reasoning", ""),
                ))
            except Exception:
                votes.append(Vote(agent=agent, option=options[0], confidence=0.3))

        # Comptage pondéré
        tallied: dict[str, float] = {o: 0.0 for o in options}
        for vote in votes:
            if vote.option in tallied:
                tallied[vote.option] += vote.confidence

        total   = sum(tallied.values()) or 1
        winner  = max(tallied, key=tallied.get)
        margins = {o: round(v/total*100, 1) for o, v in tallied.items()}

        result_dict = {
            "question":    question,
            "winner":      winner,
            "margins":     margins,
            "n_voters":    len(votes),
            "consensus":   margins[winner] > 60,   # majorité qualifiée
            "votes":       [{"agent":v.agent,"choice":v.option,
                              "conf":round(v.confidence,2)} for v in votes],
        }
        self._vote_history.append(result_dict)
        self.log.info(
            f"[PARLIAMENT] '{question[:40]}' → {winner} "
            f"({margins[winner]:.0f}% | {len(votes)} votants)"
        )
        return result_dict

    def get_democratic_params(self, agents: list[str],
                               param_options: dict) -> dict:
        """Vote sur chaque paramètre de production."""
        decided = {}
        for param, options in param_options.items():
            if len(options) > 1:
                result = self.call_vote(
                    f"Quel {param} choisir ?", options, agents[:4]
                )
                decided[param] = result["winner"]
            else:
                decided[param] = options[0]
        return decided


# ══════════════════════════════════════════════════════════════════════
# 2. EMERGENT COMMUNICATION
# Les agents développent leur propre protocole optimisé
# ══════════════════════════════════════════════════════════════════════

class EmergentCommunicationProtocol:
    """
    Protocole de communication émergent entre agents.

    Inspiré de la recherche sur l'émergence du langage dans les systèmes multi-agents.
    Les agents développent des "mots" courts pour décrire des concepts complexes,
    réduisant la bande passante de communication.

    Exemples émergents dans OverLord :
    "dark_epic_720" → [mood=dark, energy=epic, bpm=720]
    "char3_action_gold" → [3 personnages, action, palette dorée]
    """

    def __init__(self):
        self._vocabulary: dict[str, dict] = {}   # token → signification
        self._usage_count: dict[str, int] = {}
        self._compression_history: list[dict] = []

    def encode(self, message: dict) -> str:
        """Encode un message structuré en token court."""
        # Vérifier si un token existant couvre ce message
        for token, meaning in self._vocabulary.items():
            if all(message.get(k) == v for k, v in meaning.items()):
                self._usage_count[token] = self._usage_count.get(token, 0) + 1
                return token

        # Créer un nouveau token
        token = self._generate_token(message)
        self._vocabulary[token] = dict(message)
        self._usage_count[token] = 1
        return token

    def decode(self, token: str) -> dict:
        """Décode un token en message structuré."""
        return dict(self._vocabulary.get(token, {"raw": token}))

    def _generate_token(self, message: dict) -> str:
        """Génère un token mémorisable depuis un message."""
        parts = []
        priority = ["mood", "energy", "style", "n_chars", "action", "palette"]
        for key in priority:
            if key in message:
                val = str(message[key])[:6]
                parts.append(val)
        if not parts:
            parts = [str(v)[:4] for v in list(message.values())[:3]]
        return "_".join(parts)[:20]

    def compress_context(self, context: dict) -> dict:
        """Comprime le contexte en tokens."""
        compressed = {}
        for k, v in context.items():
            if isinstance(v, dict) and len(v) > 2:
                compressed[k] = self.encode(v)
            else:
                compressed[k] = v
        self._compression_history.append({
            "original_size": len(json.dumps(context)),
            "compressed_size": len(json.dumps(compressed)),
        })
        return compressed

    def vocabulary_stats(self) -> dict:
        if not self._compression_history:
            return {"vocabulary_size": len(self._vocabulary), "compressions": 0}
        avg_ratio = sum(
            h["compressed_size"]/max(h["original_size"],1)
            for h in self._compression_history
        ) / len(self._compression_history)
        return {
            "vocabulary_size":   len(self._vocabulary),
            "compressions":      len(self._compression_history),
            "avg_compression":   f"{avg_ratio*100:.1f}%",
            "top_tokens":        sorted(self._usage_count.items(),
                                        key=lambda x:-x[1])[:5],
        }


