class CollectiveIntelligenceV120:
    """Façade Intelligence Collective V1.20."""

    def __init__(self, logger: logging.Logger = None):
        self.log         = logger or logging.getLogger("collective_v120")
        self.parliament  = AgentParliament(logger=self.log)
        self.comm        = EmergentCommunicationProtocol()
        # Nouveaux agents
        self.career      = CareerManagerAgent(logger=self.log)
        self.press       = PressAttacheAgent(logger=self.log)
        self.innovator   = StructuralInnovatorAgent(logger=self.log)
        self.monetize    = MonetizationAgent(logger=self.log)
        self.legal       = LegalComplianceAgent(logger=self.log)
        self.scout       = TalentScoutAgent(logger=self.log)

    def democratic_production_params(self, context: dict) -> dict:
        """Vote démocratique sur les paramètres de production."""
        return self.parliament.get_democratic_params(
            agents=["scenario","storyboard","production","critic","marketing"],
            param_options={
                "sampler":   ["euler_ancestral","dpm++_2m","dpm++_2m_sde"],
                "scheduler": ["normal","karras","exponential"],
                "style":     ["anime","cinematic_anime","illustration"],
            }
        )

    def get_new_agents_list(self) -> list[dict]:
        """Retourne la liste des nouveaux agents disponibles."""
        return [
            {
                "id":    agent_id,
                "icon":  info["icon"],
                "title": info["title"],
                "desc":  info["desc"],
                "role":  info["role"],
            }
            for agent_id, info in NEW_AGENTS_REGISTRY.items()
        ]

    def get_dashboard(self) -> dict:
        return {
            "version":          "1.20_collective",
            "parliament_votes": len(self.parliament._vote_history),
            "comm_vocabulary":  self.comm.vocabulary_stats(),
            "new_agents":       len(NEW_AGENTS_REGISTRY),
            "agents_list":      self.get_new_agents_list(),
        }


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)
    col = CollectiveIntelligenceV120()

    print("=== V1.20 COLLECTIVE INTELLIGENCE TEST ===\n")

    print("Nouveaux agents disponibles :")
    for a in col.get_new_agents_list():
        print(f"  {a['icon']} {a['title']:<25} — {a['desc'][:55]}")

    print("\nVote démocratique sur les paramètres :")
    params = col.democratic_production_params({"style":"anime","mood":"épique"})
    print(f"  {params}")

    print("\nTalent Scout — Benchmark :")
    bench = col.scout.benchmark_competition({"title":"Anime IA OverLord","style":"shonen"})
    print(f"  {bench['benchmark'][:200]}...")

    print("\nManager Carrière — Stratégie plateforme :")
    strat = col.career.platform_strategy("anime court métrage IA", audience_size=0)
    print(f"  {strat['strategy'][:200]}...")
