def detect_gpu() -> str:
    """
    Détecte le GPU NVIDIA via nvidia-smi.
    Retourne la clé de profil (ex: 'rtx5080').
    """
    try:
        result = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,memory.total",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=10
        )
        if result.returncode == 0:
            lines = result.stdout.strip().split("\n")
            for line in lines:
                parts = line.split(",")
                gpu_name = parts[0].strip().lower()
                vram_mb  = int(parts[1].strip()) if len(parts) > 1 else 0
                vram_gb  = vram_mb // 1024

                log.info(f"[GPU] Détecté : {gpu_name} | VRAM : {vram_gb}GB")

                # Correspondance par modèle
                for key in GPU_PROFILES:
                    if key in gpu_name.replace(" ", ""):
                        log.info(f"[GPU] Profil matchant : {key}")
                        return key

                # Correspondance par VRAM si pas de match nom
                if vram_gb >= 32:
                    return "rtx5090"
                elif vram_gb >= 24:
                    return "rtx4090"
                elif vram_gb >= 16:
                    return "rtx5080"
                elif vram_gb >= 12:
                    return "rtx3060"
                elif vram_gb >= 8:
                    return "rtx2070"
    except FileNotFoundError:
        log.warning("[GPU] nvidia-smi introuvable — profil conservateur")
    except Exception as e:
        log.warning(f"[GPU] Erreur détection : {e}")

    return "unknown"


def get_profile(gpu_key: str = None) -> dict:
    """Retourne le profil GPU (détection auto si non fourni)."""
    if gpu_key is None:
        gpu_key = detect_gpu()
    return GPU_PROFILES.get(gpu_key, GPU_PROFILES["unknown"])


def patch_workflow(profile: dict, workflow_path: Path = WORKFLOW_FILE,
                   logger: logging.Logger = None) -> bool:
    """
    Applique le profil GPU dans Combined_V35_API.json.
    Met à jour KSampler, EmptyLatentImage, VAELoader.
    """
    log_ = logger or log
    if not workflow_path.exists():
        log_.error(f"[GPU] Workflow introuvable : {workflow_path}")
        return False

    try:
        wf = json.loads(workflow_path.read_text(encoding="utf-8"))
    except Exception as e:
        log_.error(f"[GPU] Erreur lecture workflow : {e}")
        return False

    changes = []

    def set_node(node_id: str, key: str, val):
        node = wf.get(str(node_id), {})
        if "inputs" in node and node["inputs"].get(key) != val:
            node["inputs"][key] = val
            changes.append(f"  node {node_id}.{key} = {val}")

    # KSampler (node 116)
    set_node("116", "steps",        profile["steps"])
    set_node("116", "cfg",          profile["cfg"])
    set_node("116", "sampler_name", profile["sampler_name"])
    set_node("116", "scheduler",    profile["scheduler"])

    # Dimensions (nodes 75=width, 77=height, 104=EmptyLatentImage)
    set_node("75",  "value",  profile["width"])
    set_node("77",  "value",  profile["height"])
    set_node("104", "width",  profile["width"])
    set_node("104", "height", profile["height"])

    # VAE (node 100)
    set_node("100", "vae_name", profile["vae"])

    if changes:
        workflow_path.write_text(
            json.dumps(wf, indent=2, ensure_ascii=False), encoding="utf-8"
        )
        log_.info(f"[GPU] Workflow patché ({len(changes)} changements) :")
        for c in changes:
            log_.info(c)
    else:
        log_.info("[GPU] Workflow déjà à jour")

    return True


def optimize_for_gpu(gpu_key: str = None,
                     logger: logging.Logger = None) -> dict:
    """
    Point d'entrée principal.
    Détecte le GPU, applique le profil dans le workflow et config_manager.
    Retourne le profil appliqué.
    """
    log_ = logger or log

    if gpu_key is None:
        gpu_key = detect_gpu()

    profile = GPU_PROFILES.get(gpu_key, GPU_PROFILES["unknown"])
    log_.info(f"[GPU] Optimisation pour : {gpu_key} — {profile['description']}")

    # Patch workflow JSON
    patch_workflow(profile, logger=log_)

    # Patch config_manager si disponible
    try:
        from agents.config_manager import get_config
        c = get_config()
        c.apply_gpu_preset(gpu_key)
        c.set("gpu.detected", gpu_key)
        c.set("gpu.vram_gb",  profile["vram_gb"])
        log_.info(f"[GPU] Config centralisée mise à jour")
    except ImportError:
        log_.warning("[GPU] config_manager indisponible — config non mise à jour")

    return {"gpu_key": gpu_key, "profile": profile}


if __name__ == "__main__":
    import sys, io
    if hasattr(sys.stdout, "buffer"):
        sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
    logging.basicConfig(level=logging.INFO)

    print("=== GPU Optimizer V1.70 ===")
    gpu = detect_gpu()
    profile = get_profile(gpu)
    print(f"GPU détecté  : {gpu}")
    print(f"Description  : {profile['description']}")
    print(f"VRAM         : {profile['vram_gb']}GB")
    print(f"Steps        : {profile['steps']}")
    print(f"Résolution   : {profile['width']}x{profile['height']}")
    print(f"VAE          : {profile['vae']}")
    print()
    print("Appliquer ce profil au workflow ? (simulation)")
    result = optimize_for_gpu(gpu)
    print(f"Profil appliqué : {result['gpu_key']}")
