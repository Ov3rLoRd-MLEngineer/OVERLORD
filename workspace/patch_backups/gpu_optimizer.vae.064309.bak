"""
agents/gpu_optimizer.py — Optimiseur GPU Adaptatif V1.70
Détecte le GPU, applique les presets optimaux dans config_manager,
et ajuste Combined_V35_API.json en conséquence.
Supporte RTX 2070 → RTX 5090 + détection VRAM automatique.

Usage :
    from agents.gpu_optimizer import optimize_for_gpu, detect_gpu
    profile = detect_gpu()
    optimize_for_gpu(profile)
"""

import json
import logging
import subprocess
from pathlib import Path

log = logging.getLogger("gpu_optimizer")

WORKFLOW_FILE = Path("Combined_V35_API.json")

