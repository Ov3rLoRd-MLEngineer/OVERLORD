# Expressions : neutre, colere, tristesse (pour acting_intent)
POSE_DEFINITIONS = {
    # ── Vues structurelles ──
    "face": {
        "suffix":   "front view, facing viewer, full body, standing straight, arms at sides, neutral expression, character turnaround",
        "filename": "{name}_face.png",
        "label":    "Face",
    },
    "profile_left": {
