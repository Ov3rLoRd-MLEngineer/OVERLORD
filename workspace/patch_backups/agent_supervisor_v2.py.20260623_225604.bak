    """
    Charge le workflow JSON.
    Fallback : workflow minimal dynamique si Combined_V35_API.json absent.
    """
    wf_path = Path(WORKFLOW_FILE)
    if wf_path.exists():
        try:
            return json.loads(wf_path.read_text(encoding="utf-8"))
        except Exception as e:
            raise RuntimeError(f"Workflow corrompu : {WORKFLOW_FILE} — {e}")
    # Fallback : workflow minimal compatible fabricatedXL_v70 + taesdxl
    # Les prompts/seed/steps sont injectes par patch_workflow()
    return {
        "1":  {"class_type": "CheckpointLoaderSimple",
               "inputs": {"ckpt_name": "fabricatedXL_v70.safetensors"}},
        "62": {"class_type": "LoraLoader",
               "inputs": {"model": ["1",0], "clip": ["1",1],
                          "lora_name": DEFAULT_LORA_MAIN,
                          "strength_model": 1.0, "strength_clip": 1.0}},
        "87": {"class_type": "CLIPTextEncode",
               "inputs": {"text": DEFAULT_POSITIVE, "clip": ["62",1]}},
        "111":{"class_type": "CLIPTextEncode",
               "inputs": {"text": DEFAULT_NEGATIVE, "clip": ["62",1]}},
        "104":{"class_type": "EmptyLatentImage",
               "inputs": {"width": 1344, "height": 1984, "batch_size": 1}},
        "112":{"class_type": "KSampler",
               "inputs": {"model": ["62",0], "positive": ["87",0],
                          "negative": ["111",0], "latent_image": ["104",0],
                          "seed": 0, "steps": 35, "cfg": 7.0,
                          "sampler_name": "dpmpp_2m_sde",
                          "scheduler": "karras", "denoise": 1.0}},
        "6":  {"class_type": "VAEDecode",
               "inputs": {"samples": ["112",0], "vae": ["1",2]}},
        "334":{"class_type": "SaveImage",
               "inputs": {"images": ["6",0],
                          "filename_prefix": "overlord_"}},
        "500":{"class_type": "ControlNetLoader",
               "inputs": {"control_net_name": "OpenPoseXL2.safetensors"}},
        "501":{"class_type": "ControlNetApplyAdvanced",
               "inputs": {"positive": ["87",0], "negative": ["111",0],
                          "control_net": ["500",0], "image": ["502",0],
                          "strength": 1.0, "start_percent": 0.0, "end_percent": 1.0}},
        "502":{"class_type": "LoadImage",
               "inputs": {"image": "openpose_placeholder.png", "upload": "image"}},
        "503":{"class_type": "DWPreprocessor",
