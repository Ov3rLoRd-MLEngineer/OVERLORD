"""
agents/storyboard.py -- Storyboard Generator Ov3rLoRd V1.49s
Transforme un script en shot list ComfyUI.
FIX V1.49s :
  1. Prompt JSON plus explicite et strict pour llama3/Ollama
  2. Fallback minimal : genere des shots basiques si le LLM echoue
  3. Parser utilise safe_json_parse V2 (robuste texte parasite)
"""

import json
import logging
from pathlib import Path
from datetime import datetime

try:
    from agents.overlord_utils import fallback_llm, safe_json_parse
    UTILS_OK = True
except ImportError:
    UTILS_OK = False
    fallback_llm    = None
    safe_json_parse = None

try:
    from agents.context_bus import get_bus
    BUS_OK = True
except ImportError:
    BUS_OK = False

STORYBOARD_DIR = Path("workspace/storyboards")
CLAUDE_MODEL   = "claude-sonnet-4-6"
log            = logging.getLogger("storyboard")


def _llm(prompt: str, system: str = "", max_tokens: int = 1500) -> str:
    if UTILS_OK and fallback_llm:
        return fallback_llm(prompt, system=system,
                             model=CLAUDE_MODEL, max_tokens=max_tokens)
    return ""


def _parse(raw: str) -> dict | None:
    """Parse JSON avec le parser V2 robuste."""
    if not raw:
        return None
    if UTILS_OK and safe_json_parse:
        ok, data, err = safe_json_parse(raw)
        if ok and isinstance(data, dict):
            return data
        if ok and isinstance(data, list):
            return {"shots": data}
    return None


def _fallback_shots(script: dict, n: int = 6) -> dict:
    """
    Genere un storyboard minimal quand le LLM echoue.
    Utilise les scenes du script comme base.
    """
    title  = script.get("title", "Episode")
    scenes = script.get("scenes", []) or script.get("acts", [])
    shots  = []
    if scenes:
        for i, scene in enumerate(scenes[:n]):
            desc = ""
            if isinstance(scene, dict):
                desc = (scene.get("description") or
                        scene.get("action") or
                        scene.get("content") or "")
            elif isinstance(scene, str):
                desc = scene
            shots.append({
                "shot_id":     f"S{i+1:02d}",
                "scene":        i + 1,
                "description":  desc[:200] or f"Scene {i+1}",
                "positive":    f"anime style, {title}, {desc[:80]}",
                "negative":    "bad quality, blurry, deformed",
                "cfg_scale":    7.0,
                "steps":        28,
                "width":        1024,
                "height":       1536,
                "_fallback":    True,
            })
    else:
        for i in range(min(n, 4)):
            shots.append({
                "shot_id":     f"S{i+1:02d}",
                "scene":        i + 1,
                "description":  f"Scene {i+1} de {title}",
                "positive":    f"anime style, {title}, dynamic scene",
                "negative":    "bad quality, blurry, deformed",
                "cfg_scale":    7.0,
                "steps":        28,
                "width":        1024,
                "height":       1536,
                "_fallback":    True,
            })
    return {
        "title":      title,
        "shots":      shots,
        "shot_count": len(shots),
        "_source":    "fallback_minimal",
    }


def generate_storyboard(script: dict, media_type: str = "anime",
                         base_lora: str = "",
                         logger: logging.Logger = None) -> dict | None:
    """
    Genere le storyboard depuis le script.
    FIX V1.49s : prompt JSON strict + fallback minimal.
    """
    _log   = logger or log
    title  = script.get("title", "Episode")
    scenes = script.get("scenes", []) or script.get("acts", [])

    # Resumer les scenes pour le prompt (eviter de depasser le contexte Ollama)
    scenes_summary = ""
    # Normalisation : scenes peut être un dict {"scenes":[...]} ou une liste directe
    if isinstance(scenes, dict):
        scenes = scenes.get("scenes", scenes.get("acts", list(scenes.values())))
        if scenes and isinstance(scenes[0], dict) and "scenes" in scenes[0]:
            # Format acts=[{scenes:[...]}, ...] → aplatir
            flat = []
            for act in scenes:
                flat.extend(act.get("scenes", []))
            scenes = flat
    if not isinstance(scenes, list):
        scenes = []
    # Normalisation : scenes peut etre un dict ou une liste
    if isinstance(scenes, dict):
        scenes = scenes.get("scenes", scenes.get("acts", list(scenes.values())))
        if scenes and isinstance(scenes[0], dict) and "scenes" in scenes[0]:
            flat = []
            for act in scenes:
                flat.extend(act.get("scenes", []))
            scenes = flat
    if not isinstance(scenes, list):
        scenes = []
    for i, sc in enumerate(scenes[:8]):
        if isinstance(sc, dict):
            desc = (sc.get("description") or sc.get("action") or
                    sc.get("content") or "")[:150]
            scenes_summary += f"Scene {i+1}: {desc}\n"
        elif isinstance(sc, str):
            scenes_summary += f"Scene {i+1}: {sc[:150]}\n"

    if not scenes_summary:
        scenes_summary = f"Un episode de {title} en style anime."

    # Prompt tres explicite pour llama3
    # On demande UNIQUEMENT le JSON, sans texte avant ou apres
    system = (
        "Tu es un assistant specialise en storyboard pour anime. "
        "Tu reponds UNIQUEMENT avec du JSON valide, sans aucun texte avant ou apres. "
        "Pas de commentaire, pas d'explication, juste le JSON brut."
    )

    prompt = f"""Genere un storyboard JSON pour cet episode anime.

Titre: {title}
Scenes:
{scenes_summary}

Reponds avec UNIQUEMENT ce JSON (rien d'autre, pas de texte):
{{
  "title": "{title}",
  "shots": [
    {{
      "shot_id": "S01",
      "scene": 1,
      "description": "description courte de la scene",
      "positive": "prompt positif ComfyUI en anglais, anime style",
      "negative": "bad quality, blurry, deformed",
      "cfg_scale": 7.0,
      "steps": 28,
      "width": 1024,
      "height": 1536
    }}
  ]
}}

Genere entre 4 et 8 shots. JSON uniquement, pas de texte."""

    _log.info(f"[STORYBOARD] Generation -- titre='{title}'")

    for attempt in range(3):
        raw = _llm(prompt, system=system, max_tokens=1500)
        if not raw:
            _log.warning(f"[STORYBOARD] LLM vide (tentative {attempt+1}/3)")
            continue

        result = _parse(raw)
        if result and result.get("shots"):
            n = len(result["shots"])
            _log.info(f"[STORYBOARD] OK -- {n} shots generes")
            if BUS_OK:
                try:
                    get_bus().write("storyboard.shots_count", n,
                                    agent_id="storyboard")
                except Exception:
                    pass
            return result

        _log.warning(
            f"[STORYBOARD] JSON invalide (tentative {attempt+1}/3) "
            f"-- reponse : {raw[:120] if raw else 'vide'}")

    # Toutes les tentatives ont echoue -> fallback minimal
    _log.warning(
        "[STORYBOARD] Echec LLM apres 3 tentatives -- "
        "utilisation du fallback minimal")
    result = _fallback_shots(script)
    n = len(result["shots"])
    _log.info(f"[STORYBOARD] Fallback minimal -- {n} shots")
    if BUS_OK:
        try:
            get_bus().write("storyboard.shots_count", n,
                            agent_id="storyboard")
            get_bus().write("storyboard.source", "fallback",
                            agent_id="storyboard")
        except Exception:
            pass
    return result


def shots_to_jobs(storyboard: dict, base_lora: str = "") -> list[dict]:
    """Convertit les shots en jobs ComfyUI."""
    jobs = []
    for shot in storyboard.get("shots", []):
        job = {
            "positive":  shot.get("positive", "anime style, masterpiece"),
            "negative":  shot.get("negative",
                                   "bad quality, blurry, deformed, watermark"),
            "lora":      base_lora,
            "cfg_scale": shot.get("cfg_scale", 7.0),
            "steps":     shot.get("steps", 28),
            "width":     shot.get("width", 1024),
            "height":    shot.get("height", 1536),
            "_shot_meta": {
                "shot_id":     shot.get("shot_id", ""),
                "description": shot.get("description", ""),
                "scene":       shot.get("scene", 1),
                "_fallback":   shot.get("_fallback", False),
            },
        }
        jobs.append(job)
    return jobs


def run_storyboard(script: dict, media_type: str = "anime",
                   base_lora: str = "",
                   logger: logging.Logger = None) -> tuple[dict, list]:
    """
    Point d'entree principal appele depuis maestro.py.
    Retourne (storyboard, jobs).
    """
    _log = logger or log
    STORYBOARD_DIR.mkdir(parents=True, exist_ok=True)

    storyboard = generate_storyboard(script, media_type=media_type,
                                      base_lora=base_lora, logger=_log)

    if not storyboard:
        _log.error("[STORYBOARD] Echec generation -- storyboard vide")
        return {"error": "json_parse_failed", "shots": []}, []

    # Sauvegarder
    ts   = datetime.now().strftime("%Y%m%d_%H%M%S")
    name = (storyboard.get("title") or "storyboard").replace("/", "_")[:50]
    path = STORYBOARD_DIR / f"{ts}_{name}.json"
    try:
        path.write_text(
            json.dumps(storyboard, ensure_ascii=False, indent=2,
                       default=str),
            encoding="utf-8")
        _log.info(f"[STORYBOARD] Sauvegarde -> {path.name}")
    except Exception as e:
        _log.warning(f"[STORYBOARD] Sauvegarde echouee : {e}")

    jobs = shots_to_jobs(storyboard, base_lora=base_lora)
    _log.info(f"[STORYBOARD] {len(jobs)} jobs ComfyUI prepares")

    # Passe 0 — Préparer les métadonnées de croquis pour chaque job
    # La génération réelle des croquis se fait dans agent_supervisor_v2.py
    # en deux temps : sketch pass (steps=12) puis production pass avec référence
    from pathlib import Path
    _sb_title    = storyboard.get("title", "run") if isinstance(storyboard, dict) else "run"
    # Sanitize : supprimer les caractères interdits Windows dans les noms de dossier
    import re as _re
    _sb_title = _re.sub(r'[\\/:*?"<>|]', '_', _sb_title or "run")[:60]
    sketches_dir = Path("workspace/storyboards/sketches") / (_sb_title or "run")
    sketches_dir.mkdir(parents=True, exist_ok=True)

    for i, job in enumerate(jobs):
        job["sketch_path"]    = str(sketches_dir / f"sketch_{i+1:02d}.png")
        job["has_sketch_ref"] = False  # sera True après la passe sketch
        job["sketch_prompt"]  = (
            "sketch, simple line art, rough composition study, "
            "black and white lines only, no shading, no color, "
            f"{job.get('positive','')[:80]}"
        )
        # Passes production par couches (architecture studio)
        # Pass 1 : background pur
        # Pass 2 : perso A sans background + detailer
        # Pass 3 : perso B sans background + detailer
        # Pass 4 : FX overlay
        job["production_passes"] = ["background", "character_a", "character_b", "fx"]
        job["composite_order"]   = ["background", "character_b", "character_a", "fx"]

    _log.info(f"[STORYBOARD] Métadonnées passes studio ajoutées à {len(jobs)} jobs")

    # ── Prompt Translator V1.1 : enrichissement intent de realisation ──
    # Injecte shot_type, lighting, acting_intent, camera_movement
    # et remplace positive/negative par la traduction ComfyUI optimisee.
    # get_recommended_duration() alimente duration_s pour postprod/pacing.
    try:
        from agents.prompt_translator import translate_storyboard, get_recommended_duration
        universe = script.get("universe", "") or media_type
        jobs = translate_storyboard(jobs, universe=universe, logger=_log)
        # Injecter la duree de plan recommandee dans chaque job
        for job in jobs:
            intent = job.get("_intent", {})
            job["duration_s"] = get_recommended_duration(intent)
        _log.info("[STORYBOARD] Prompt Translator OK -- intents de realisation injectes")
    except Exception as _pt_err:
        _log.warning("[STORYBOARD] Prompt Translator indisponible : %s", _pt_err)

    return storyboard, jobs


if __name__ == "__main__":
    import sys, io
    if hasattr(sys.stdout, "buffer"):
        sys.stdout = io.TextIOWrapper(
            sys.stdout.buffer, encoding="utf-8", errors="replace")
    logging.basicConfig(level=logging.INFO)

    test_script = {
        "title": "Dragon Ball: L'Eveil de Broly",
        "scenes": [
            {"description": "Goku s'entraine dans les plaines au lever du soleil"},
            {"description": "Broly arrive en meteor depuis l'espace"},
            {"description": "Combat epique dans le desert"},
            {"description": "Resolution emotionnelle, les deux guerriers se respectent"},
        ]
    }

    storyboard, jobs = run_storyboard(test_script)
    print(f"Shots    : {len(storyboard.get('shots', []))}")
    print(f"Jobs     : {len(jobs)}")
    print(f"Source   : {storyboard.get('_source', 'llm')}")
    if jobs:
        print(f"Job 1    : {jobs[0]['positive'][:80]}")