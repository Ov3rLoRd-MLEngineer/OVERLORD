"""
agents/overlord_utils.py -- Utilitaires centraux Ov3rLoRd V1.49r
FIX V1.49r :
  1. safe_json_parse() accepte **kwargs silencieux (logger=log dans scenario.py)
  2. _get_llm_mode() relit .env a chaque appel (OV_LLM_MODE=offline pris en compte)
"""

import json
import logging
import os
import time
from pathlib import Path

log = logging.getLogger("overlord_utils")

ANTHROPIC_URL        = "https://api.anthropic.com/v1/messages"
OLLAMA_URL           = "http://localhost:11434"
DEFAULT_MODEL        = "claude-sonnet-4-6"
DEFAULT_OLLAMA_MODEL = "llama3"


def get_api_key(env_file: Path = None) -> str:
    key = os.environ.get("ANTHROPIC_API_KEY", "")
    if key:
        return key
    search_paths = []
    if env_file:
        search_paths.append(Path(env_file))
    p = Path(__file__).resolve()
    for _ in range(4):
        p = p.parent
        search_paths.append(p / ".env")
    for env_path in search_paths:
        if env_path.exists():
            try:
                for line in env_path.read_text(encoding="utf-8").splitlines():
                    if line.startswith("ANTHROPIC_API_KEY="):
                        key = line.split("=", 1)[1].strip().strip('"').strip("'")
                        if key:
                            return key
            except Exception:
                pass
    return ""


def build_headers(api_key: str = None) -> dict:
    key = api_key or get_api_key()
    return {
        "Content-Type":      "application/json",
        "x-api-key":         key,
        "anthropic-version": "2023-06-01",
    }


def retry_api(fn, retries: int = 3, delay: float = 2.0):
    for attempt in range(retries):
        try:
            return fn()
        except Exception as e:
            if attempt < retries - 1:
                time.sleep(delay * (attempt + 1))
            else:
                raise


def safe_json_parse(raw: str, **kwargs) -> tuple:
    """
    Parse JSON robuste.
    FIX V1.49r : accepte **kwargs silencieux.
    scenario.py et d'autres modules appelaient safe_json_parse(raw, logger=log)
    ce qui causait TypeError. Le kwarg logger est desormais simplement ignore.
    Retourne (success: bool, data, error_msg: str).
    """
    if not raw:
        return False, None, "chaine vide"
    try:
        clean = raw.strip()
        if "```json" in clean:
            clean = clean.split("```json", 1)[1].split("```", 1)[0].strip()
        elif "```" in clean:
            clean = clean.split("```", 1)[1].split("```", 1)[0].strip()
        for i, c in enumerate(clean):
            if c in "{[":
                clean = clean[i:]
                break
        data = json.loads(clean)
        return True, data, ""
    except json.JSONDecodeError as e:
        return False, None, str(e)


def _read_env_value(key: str) -> str:
    """Lit une valeur depuis le fichier .env le plus proche."""
    p = Path(__file__).resolve()
    for _ in range(4):
        p = p.parent
        env_path = p / ".env"
        if env_path.exists():
            try:
                for line in env_path.read_text(encoding="utf-8").splitlines():
                    line = line.strip()
                    if line.startswith(f"{key}="):
                        return line.split("=", 1)[1].strip().strip('"').strip("'")
            except Exception:
                pass
    return ""


def _get_llm_mode() -> str:
    """
    Retourne le mode LLM : 'online' | 'offline' | 'auto'.
    FIX V1.49r : relit .env a chaque appel.
    Priorite : variable Windows > .env > auto-detect.
    """
    mode = os.environ.get("OV_LLM_MODE", "").lower().strip()
    if mode in ("online", "offline", "auto"):
        return mode
    mode = _read_env_value("OV_LLM_MODE").lower()
    if mode in ("online", "offline", "auto"):
        return mode
    return "auto" if get_api_key() else "offline"


def _get_ollama_model() -> str:
    m = os.environ.get("OV_OLLAMA_MODEL", "").strip()
    if m:
        return m
    m = _read_env_value("OV_OLLAMA_MODEL").strip()
    return m if m else DEFAULT_OLLAMA_MODEL


def _call_claude(prompt: str, system: str = "",
                 model: str = DEFAULT_MODEL,
                 max_tokens: int = 1000) -> str:
    import requests
    key = get_api_key()
    if not key:
        raise ValueError("ANTHROPIC_API_KEY absent")
    body = {
        "model":      model,
        "max_tokens": max_tokens,
        "messages":   [{"role": "user", "content": prompt}],
    }
    if system:
        body["system"] = system
    resp = requests.post(
        ANTHROPIC_URL, headers=build_headers(key), json=body, timeout=60)
    if resp.status_code == 200:
        content = resp.json().get("content", [])
        return "".join(c.get("text", "") for c in content
                       if c.get("type") == "text")
    raise RuntimeError(f"Claude HTTP {resp.status_code} : {resp.text[:200]}")


def _call_ollama(prompt: str, system: str = "",
                 model: str = None,
                 max_tokens: int = 1000) -> str:
    import requests
    ollama_model = _get_ollama_model()
    if model and "claude" not in model.lower() and "/" not in model:
        ollama_model = model
    messages = []
    if system:
        messages.append({"role": "system", "content": system})
    messages.append({"role": "user", "content": prompt})
    try:
        resp = requests.post(
            f"{OLLAMA_URL}/api/chat",
            json={"model": ollama_model, "messages": messages,
                  "stream": False,
                  "options": {"num_predict": max_tokens}},
            timeout=120)
        if resp.status_code == 200:
            return resp.json().get("message", {}).get("content", "")
    except Exception:
        pass
    full_prompt = f"{system}\n\n{prompt}" if system else prompt
    resp = requests.post(
        f"{OLLAMA_URL}/api/generate",
        json={"model": ollama_model, "prompt": full_prompt,
              "stream": False,
              "options": {"num_predict": max_tokens}},
        timeout=120)
    if resp.status_code == 200:
        return resp.json().get("response", "")
    raise RuntimeError(f"Ollama HTTP {resp.status_code}")


def is_ollama_available(model: str = None) -> bool:
    import requests
    try:
        r = requests.get(f"{OLLAMA_URL}/api/tags", timeout=3)
        if r.status_code != 200:
            return False
        if model:
            models = [m.get("name", "") for m in r.json().get("models", [])]
            return any(model in m for m in models)
        return True
    except Exception:
        return False


def fallback_llm(prompt: str, system: str = "",
                 model: str = DEFAULT_MODEL,
                 max_tokens: int = 1000,
                 logger: logging.Logger = None) -> str:
    """
    Point d'entree LLM principal pour tous les agents Ov3rLoRd.
    Relit OV_LLM_MODE depuis .env a chaque appel.
    offline -> Ollama direct
    online  -> Claude uniquement
    auto    -> Claude puis Ollama si echec
    """
    _log     = logger or log
    llm_mode = _get_llm_mode()

    if llm_mode == "offline":
        ollama_model = _get_ollama_model()
        try:
            result = _call_ollama(prompt, system=system,
                                   model=ollama_model,
                                   max_tokens=max_tokens)
            _log.debug(f"[LLM] Ollama/{ollama_model} OK ({len(result)} chars)")
            return result
        except Exception as e:
            _log.error(f"[LLM] Ollama indisponible en mode offline : {e}")
            return ""

    key = get_api_key()
    if key:
        try:
            result = _call_claude(prompt, system=system,
                                   model=model, max_tokens=max_tokens)
            _log.debug(f"[LLM] Claude/{model} OK ({len(result)} chars)")
            return result
        except Exception as e:
            if llm_mode == "online":
                _log.error(
                    "[LLM] Claude indisponible et mode=online -- aucun fallback")
                return ""
            _log.warning(
                f"[LLM] Claude echoue : {str(e)[:120]} -- tentative Ollama")

    if llm_mode == "online":
        _log.error("[LLM] Claude indisponible et mode=online -- aucun fallback")
        return ""

    ollama_model = _get_ollama_model()
    try:
        if is_ollama_available():
            result = _call_ollama(prompt, system=system,
                                   model=ollama_model,
                                   max_tokens=max_tokens)
            _log.info(
                f"[LLM] Fallback Ollama/{ollama_model} OK ({len(result)} chars)")
            return result
        else:
            _log.warning(
                f"[LLM] Ollama : modele '{ollama_model}' non disponible -- "
                f"lance : ollama pull {ollama_model}")
    except Exception as e:
        _log.error(f"[LLM] Ollama indisponible : {e}")
    return ""


def ensure_workspace(base: Path = None) -> Path:
    ws = (base or Path(".")) / "workspace"
    for sub in ["logs", "scripts", "storyboards", "checkpoints",
                 "archive", "narrative", "asset_library", "generation",
                 "v120_learning", "dream_mode", "context_bus"]:
        (ws / sub).mkdir(parents=True, exist_ok=True)
    return ws


def ensure_env_file(base: Path = None) -> Path:
    env_path = (base or Path(".")) / ".env"
    if not env_path.exists():
        env_path.write_text(
            "# Ov3rLoRd -- Configuration\n"
            "ANTHROPIC_API_KEY=\n"
            "# LLM mode : online | offline | auto\n"
            "OV_LLM_MODE=offline\n"
            "# Modele Ollama\n"
            "OV_OLLAMA_MODEL=llama3\n",
            encoding="utf-8")
        log.info(f"[UTILS] .env cree : {env_path}")
    return env_path


if __name__ == "__main__":
    import sys, io
    if hasattr(sys.stdout, "buffer"):
        sys.stdout = io.TextIOWrapper(
            sys.stdout.buffer, encoding="utf-8", errors="replace")
    logging.basicConfig(level=logging.INFO)
    print(f"Mode LLM      : {_get_llm_mode()}")
    print(f"Modele Ollama : {_get_ollama_model()}")
    print(f"Cle API       : {'presente' if get_api_key() else 'absente'}")
    print(f"Ollama dispo  : {is_ollama_available()}")
    ok, data, err = safe_json_parse('{"test": 42}', logger=None)
    print(f"safe_json_parse OK : {ok} | {data}")
    r = fallback_llm("Dis OK en un mot.", max_tokens=5)
    print(f"LLM reponse   : '{r}'")